# MixBench FastAPI DSP Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=7860

# Comma-separated Vercel & local frontend origins (or '*' for public access)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://frontend-tau-kohl-prgmf10seo.vercel.app

# Upload & ephemeral session storage limits
MAX_SINGLE_FILE_MB=50
MAX_STEM_TOTAL_MB=150
SESSION_TTL_MINUTES=60

# Optional Gemini API integration (leave empty to use Offline Deterministic Mentor fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
